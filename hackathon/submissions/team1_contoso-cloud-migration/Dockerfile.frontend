# ── Stage 1: build Vue app ────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /build

COPY client/package*.json ./
RUN npm ci --silent

COPY client/ .
RUN npm run build
# Output: /build/dist/

# ── Stage 2: serve with nginx (minimal, non-root) ─────────────────────────────
FROM nginx:1.25-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Non-root: nginx listens on 8080 instead of 80
COPY --chown=nginx:nginx hackathon/submissions/team1_contoso-cloud-migration/nginx.conf /etc/nginx/conf.d/app.conf

# Copy built assets
COPY --from=builder --chown=nginx:nginx /build/dist /usr/share/nginx/html

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8080/health || exit 1

EXPOSE 8080

USER nginx
